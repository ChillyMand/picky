{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "picky",
  "main": "worker.js",
  "account_id": "16ab0366b94c2e1a89cb3dab3fee4e34",
  "compatibility_date": "2026-08-11",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "picky",
    "database_id": "cd86f836-6b58-4965-b22c-0f5857b8d0ac",
    "migrations_dir": "./migrations"
  }],
  "routes": [{ "pattern": "picky.wzrice.cn", "custom_domain": true }]
}
